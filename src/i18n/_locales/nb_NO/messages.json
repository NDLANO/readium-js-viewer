  "i18n_ChromeApp_deprecated_dialog_title" : {
    "message" : "Readium Chrome-app - ADVARSEL"
  },
  "i18n_ChromeApp_deprecated_dialog_HTML" : {
    "message" : "<p><strong><u>VIKTIG:</u></strong></p><p>Dette er den siste versjonen av Readium Chrome-appen. Google har bestemt seg for å fjerne støtte for «apper» i nettleseren Chrome, som <a href=\"https://developer.chrome.com/apps/migration\" target=\"_blank\">forklart her</a>.</p> <p>På et tidspunkt vil Google slå av alle eksisterende Chrome-apper. Dette kan Readium dessverre ikke gjøre noe med.</p> <p>Vurder derfor å bruke annen programvare for å lese EPUB-filer. Besøk <a href=\"https://readium.org/about/applications.html/\" target=\"_blank\">nettstedet til Readium</a> for forslag.</p>"
  },
