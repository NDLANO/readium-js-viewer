  "i18n_ChromeApp_deprecated_dialog_title" : {
    "message" : "Readium Chrome-app - ÅTVARING"
  },
  "i18n_ChromeApp_deprecated_dialog_HTML" : {
    "message" : "<p><strong><u>VIKTIG:</u></strong></p><p>Dette er den siste versjonen av Readium Chrome-appen. Google har bestemt seg for å fjerne støtte for «appar» i nettlesaren Chrome, som <a href=\"https://developer.chrome.com/apps/migration\" target=\"_blank\">forklart her</a>.</p> <p>Ein gong vil Google slå av alle eksisterande Chrome-appar. Dette kan Readium dessverre ikkje gjere noko med.</p> <p>Vurder difor å bruke anna programvare for å lese EPUB-filer. Besøk <a href=\"https://readium.org/about/applications.html/\" target=\"_blank\">nettstaden til Readium</a> for forslag.</p>"
  },
